{
  "manifest_version": 3,
  "name": "OneDesk Native Viewer",
  "version": "1.0",
  "description": "Seamlessly browses your host machine sessions in a native incognito window.",
  "permissions": [
    "cookies",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onedesk-upet.onrender.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
